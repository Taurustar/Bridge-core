# Discord adapter (v1.1.0). Defaults off / empty.
# Copy to Bridge-core/discord.env or discord_adapter/discord.env. Never commit the copy.
# The token is a secret: never put it in /status or INFO logs.

DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=

# Allowlisted guilds and channels. Empty = none (never "all servers").
DISCORD_GUILD_IDS=
DISCORD_CHANNEL_IDS=

# Owner DMs join the app companion thread. Stranger DMs stay separate.
DISCORD_DM_OWNER_ENABLED=false
DISCORD_DM_STRANGERS_ENABLED=false
DISCORD_OWNER_USER_ID=

# Voice-message files, not live voice channels. Vision is optional.
DISCORD_STT_ENABLED=false
DISCORD_TTS_ENABLED=false
DISCORD_VISION_ENABLED=false

# Per-author rate limit.
DISCORD_RATE_MAX=8
DISCORD_RATE_WINDOW_SECONDS=60
