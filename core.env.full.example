# Bridge Core Engine — full single-owner feature profile (example).
#
# This is the intended single-owner deployment profile: needs, state
# expression, owner profile, schedule, life, memory extraction/cleanup,
# heartbeat initiative, work, sessions, daily tools, contextual owner
# schedule, and device support are ON where credentials/files exist.
# External-user profile behavior stays off (dormant store only).
#
# Fill in every blank credential before running. Real environment
# variables override file values. Never commit a live core.env.

# Server (production: bind the Tailscale address)
BRIDGE_HOST=100.x.y.z
BRIDGE_PORT=8766
TAILSCALE_REQUIRED=true
TAILSCALE_FIREWALL_ACK=false
LOG_LEVEL=info
OWNER_USER_ID=owner
DEFAULT_LANGUAGE=en
OWNER_TIMEZONE=UTC
CHARACTER_TIMEZONE=UTC

# Redis (required) and Chroma (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
CHROMA_ENABLED=false
CHROMA_PATH=./data/chroma
CHROMA_REQUIRED=false

# LLM routing — set at least one provider chain entry with credentials.
LLM_CHAIN=fireworks,ollama
LLM_CHAIN_DEADLINE_SECONDS=75
LLM_HISTORY_MESSAGE_BUDGET=40
LLM_STREAMING_ENABLED=false

FIREWORKS_API_KEY=
FIREWORKS_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=
FIREWORKS_TIMEOUT=60
FIREWORKS_SERVICE_TIER=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

COMPANION_PROVIDERS=
COMPANION_MODEL=
COMPANION_TEMPERATURE=0.8
COMPANION_MAX_TOKENS=1200

WORK_PROVIDERS=
WORK_MODEL=
WORK_TEMPERATURE=0.3
WORK_MAX_TOKENS=4000

LIFE_PROVIDERS=
LIFE_MODEL=
LIFE_TEMPERATURE=0.8
LIFE_MAX_TOKENS=400

PROACTIVE_PROVIDERS=
PROACTIVE_MODEL=
PROACTIVE_TEMPERATURE=0.8
PROACTIVE_MAX_TOKENS=120

OWNER_PROFILE_LLM_ENABLED=true
OWNER_PROFILE_PROVIDERS=
OWNER_PROFILE_MODEL=
OWNER_PROFILE_MAX_TOKENS=400

# Identity (blank = repo defaults)
SOUL_FILE=
PROFILE_FILE=
STATE_FILE=
WORK_SKILLS_FILE=
DAILY_SKILLS_FILE=

# TTS (enable with ElevenLabs credentials)
TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_OUTPUT_FORMAT=mp3_44100_128
TTS_CHUNK_THRESHOLD=150
TTS_CHUNK_SIZE=150
TTS_CHUNK_SPACING_MS=50
TTS_VOICE_PROFILE_FILE=

# STT (enable with Deepgram or AssemblyAI credentials)
STT_ENABLED=false
STT_PROVIDER=deepgram
STT_LANGUAGE=en
DEEPGRAM_API_KEY=
DEEPGRAM_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TIMEOUT=45
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_URL=https://api.assemblyai.com/v2
ASSEMBLYAI_SPEECH_MODEL=best
ASSEMBLYAI_TIMEOUT=90
ASSEMBLYAI_POLL_INTERVAL=1

# History and memory
MAX_HISTORY_TURNS=80
COMPANION_SHORT_WINDOW_ENABLED=true
COMPANION_LIVE_WINDOW_MESSAGES=8
COMPANION_COMPACT_THRESHOLD=60
COMPANION_KEEP_RECENT=16
MIDTERM_INJECT_CHAPTERS=4
MEMORY_EXTRACTION_ENABLED=true
MEMORY_CLEANUP_ENABLED=true
MEMORY_CLEANUP_INTERVAL_HOURS=12
MEMORY_MAX_PER_USER=1000
MEMORY_TEMPERATURE=0.2
MEMORY_CHAPTER_MAX_CHARS=800
MEMORY_CONVERSATION_TTL_DAYS=30
MEMORY_LIFE_TTL_DAYS=365
MEMORY_PROTECTED_PROJECT_FLOOR=0.7
CONTEXT_FEED_ENABLED=true

# Needs and interaction (full profile: ON)
NEEDS_ENABLED=true
BIDS_ENABLED=true
RHYTHM_ENABLED=true
STATE_EXPRESSION_ENABLED=true
NEEDS_PROFILE_FILE=

# Owner profile (full profile: ON; tune thresholds in schedule/needs.json)
OWNER_PROFILE_ENABLED=true
OWNER_PROFILE_INJECT=true
OWNER_STATUS_START=acquaintance
OWNER_TRUST_START=50
OWNER_CLOSENESS_START=0
OWNER_APPEAL_START=50
OWNER_DESIRABILITY_START=50
OWNER_BOUNDARY_PENALTIES_ENABLED=true
OWNER_SOFT_BLOCK_ENABLED=true
OWNER_SOFT_BLOCK_COOLDOWN_SECONDS=3600
OWNER_SOFT_BLOCK_UNBLOCK_TRUST_FLOOR=25
OWNER_BOUNDARY_PENALTY_MINOR=3
OWNER_BOUNDARY_PENALTY_MODERATE=6
OWNER_BOUNDARY_PENALTY_MAJOR=12
OWNER_STATUS_DRIFT_ENABLED=true
OWNER_AGREEMENTS_ENABLED=true
OWNER_AGREEMENT_AFTERMATH_ENABLED=true

# Dormant gateway profiles (behavior stays OFF in v1)
EXTERNAL_USER_PROFILE_STORE_ENABLED=true
EXTERNAL_USER_PROFILES_BEHAVIOR_ENABLED=false
EXTERNAL_USER_PROFILE_LLM_ENABLED=false

# Schedule and life (enable after authoring schedule/ and life_events/ files)
SCHEDULE_ENABLED=true
SCHEDULE_DIR=
LIFE_SKIP_ACTIVITIES=sleep
SCHEDULE_SOFT_BUSY_POLICY=normal
LIFE_ENABLED=true
LIFE_EVENTS_DIR=
LIFE_DAILY_MIN=0
LIFE_DAILY_MAX=4
LIFE_EVENT_COOLDOWN_MINUTES=40
LIFE_POLL_INTERVAL_SECONDS=60
LIFE_MISSED_BLOCK_POLICY=current_only

# Heartbeat initiative
HEARTBEAT_ENABLED=true
INITIATIVE_ENABLED=true
INITIATIVE_MIN_HEARTBEATS=3
INITIATIVE_HEARTBEAT_WINDOW_SECONDS=900
INITIATIVE_HEARTBEAT_COUNT_INTERVAL_SECONDS=60
INITIATIVE_MIN_GAP_SECONDS=3600
INITIATIVE_DAILY_MAX=3
INITIATIVE_REQUIRE_SCHEDULE_FREE=true
INITIATIVE_ELIGIBILITY_CHANCE=0.35

# Work and MCP
WORK_ENABLED=true
SESSIONS_ENABLED=true
SESSION_HISTORY_TURNS=80
SESSION_SUMMARY_ENABLED=true
WORK_SKILLS_ENABLED=true
MCP_PROXY_ENABLED=true
MCP_TOOL_TIMEOUT=120
MCP_MAX_ITERATIONS=20
MCP_VERIFICATION_ENABLED=true
MCP_VERIFICATION_RETRIES=2
AGENT_CHECKPOINTS_ENABLED=true

# Device daemon (clients must explicitly arm)
DEVICE_ENABLED=true
DEVICE_TOOL_TIMEOUT=120
DEVICE_PER_TURN_CALL_CAP=20
DEVICE_MAX_OUTPUT_CHARS=30000
DEVICE_SHELL_TIMEOUT=120
DEVICE_SHELL_TIMEOUT_MAX=600
DEVICE_WRITE_ROOTS=

# Daily tools and web
DAILY_TOOLS_ENABLED=true
DAILY_WEB_ENABLED=true
TAVILY_API_KEY=
DAILY_WEB_SEARCH_CAP=1
DAILY_WEB_OPEN_CAP=2
DAILY_TOOL_MAX_CALLS=6
DAILY_WEB_MAX_BYTES=500000
DAILY_WEB_MAX_TEXT_CHARS=4000
DAILY_WEB_TIMEOUT=20

# Contextual owner schedule
USER_SCHEDULE_ENABLED=true

# Input and context budgets
MAX_AUDIO_BYTES=15728640
ALLOWED_AUDIO_CONTENT_TYPES=audio/webm,audio/ogg,audio/mpeg,audio/wav
CONTEXT_FEED_MAX_TOKENS=700
NEEDS_MAX_ELAPSED_HOURS=48

# Additional analysis routes
MEMORY_PROVIDERS=
MEMORY_MODEL=
MEMORY_MAX_TOKENS=400
SESSION_SUMMARY_PROVIDERS=
SESSION_SUMMARY_MODEL=
SESSION_SUMMARY_MAX_TOKENS=500

# Client emotion/animation manifest (blank = bundled neutral defaults)
EMOTIONS_FILE=
STATIC_LINES_FILE=
