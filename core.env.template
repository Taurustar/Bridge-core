# Bridge Core Engine configuration template.
# Copy to core.env and edit. Real environment variables override file values.
# Safe defaults: all behavior flags OFF, localhost bind, blank secrets.

# Server
# Required in production: set to this server's Tailscale IPv4/IPv6 address.
# Safe local default does not expose the service.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8766
TAILSCALE_REQUIRED=true
TAILSCALE_FIREWALL_ACK=false
LOG_LEVEL=info
OWNER_USER_ID=owner
